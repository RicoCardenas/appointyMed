# Copia este archivo a .env (ignorado por Git) y completa los valores.
# Exporta las variables antes de `mvn -pl <servicio> spring-boot:run`, por ejemplo:
#   set -a; source .env; set +a

# Una clave por servicio: la misma que pasaste a db/init.sql
AUTH_DB_PASSWORD=
CATALOG_DB_PASSWORD=
APPOINTMENT_DB_PASSWORD=
CLINICAL_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# Opcional: valores por defecto en application.yml
# DB_URL=jdbc:postgresql://localhost:5432/appointy

# auth-service. JWT_SECRET: minimo 32 caracteres y el mismo valor en todos los servicios.
JWT_SECRET=
# Administrador inicial (opcional): se crea solo si aun no existe ningun ADMINISTRATIVO.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# catalog-service y servicios que usan /internal: la misma llave en todos (minimo 24 caracteres).
INTERNAL_API_KEY=
# Opcionales: APPOINTMENT_SERVICE_URL (http://localhost:8083), APP_TIMEZONE (America/Bogota)
