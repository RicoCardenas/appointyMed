# Copia este archivo a .env (ignorado por Git) y completa los valores.
# Exporta las variables antes de `mvn -pl <servicio> spring-boot:run`, por ejemplo:
#   set -a; source .env; set +a

# Una clave por servicio: la misma que pasaste a db/init.sql
AUTH_DB_PASSWORD=
CATALOG_DB_PASSWORD=
APPOINTMENT_DB_PASSWORD=
CLINICAL_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# Opcional: valores por defecto en application.yml
# DB_URL=jdbc:postgresql://localhost:5432/appointy
