        "properties": {
          "activo": {
            "type": "boolean"
          },
          "centroId": {
            "type": "string"
          },
          "diaSemana": {
            "format": "int32",
            "type": "integer"
          },
          "duracionFranjaMin": {
            "format": "int32",
            "type": "integer"
