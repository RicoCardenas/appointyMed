          "activo": {
            "type": "boolean"
          },
          "ciudad": {
            "type": "string"
          },
          "direccion": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CrearProfesionalRequest": {
        "properties": {
          "apellidos": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "nombres": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
