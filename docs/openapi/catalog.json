          "centroId": {
            "type": "string"
          },
          "creadoEn": {
            "format": "date-time",
            "type": "string"
          },
          "creadoPor": {
            "type": "string"
          },
          "fechaFin": {
            "type": "string"
          },
          "fechaInicio": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          },
          "profesionalId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CentroRequest": {
