          "ciudad": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "direccion": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "nombre": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "telefono": {
            "pattern": "^[0-9+() -]{7,20}$",
