        "required": [
          "apellidos",
          "nombres",
          "registroMedico"
        ],
        "type": "object"
      },
      "BloqueoRequest": {
        "properties": {
          "centroId": {
            "format": "uuid",
            "type": "string"
          },
          "fechaFin": {
            "format": "date",
            "type": "string"
          },
          "fechaInicio": {
            "format": "date",
            "type": "string"
          },
          "motivo": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "profesionalId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "centroId",
          "fechaFin",
          "fechaInicio",
          "motivo",
          "profesionalId"
